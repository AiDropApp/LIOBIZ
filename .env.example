# Liobiz environment
# Copy to .env.local for local development

# Public site URL (used in metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# SQLite DB lives at data/liobiz.db (created automatically)
# For VPS keep this folder writable and backed up:
#   data/
#   public/uploads/

# Optional: external media CDN (future — keep empty to store uploads on this server)
# UPLOAD_PROVIDER=local
# EXTERNAL_UPLOAD_API_URL=
# EXTERNAL_UPLOAD_API_KEY=

# Files.ir — مرکز رسانه (فقط سرور؛ هرگز در فرانت قرار ندهید)
# روش ۱ (پیشنهادی): Personal Access Token از my.files.ir → Developers
FILESIR_ACCESS_TOKEN=
# FILESIR_API_BASE=https://my.files.ir/api/v1
# FILESIR_PUBLIC_BASE=https://my.files.ir

# روش ۲ (fallback): ورود با ایمیل
# FILESIR_EMAIL=
# FILESIR_PASSWORD=
# FILESIR_TOKEN_NAME=liobiz-server

PORT=3001

# Session cookie signing (required in production)
AUTH_SECRET=change-me-to-a-long-random-string

# Cloudflare Turnstile (optional — form works with honeypot if unset)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Initial admin seed (only used when DB has no admin with this email)
ADMIN_EMAIL=admin@liobiz.com
ADMIN_PASSWORD=change-me-before-production
ADMIN_NAME=مدیر لیوبیز

# Nightly backup upload to MyFiles (Liobiz/backup/) — needs FILESIR_ACCESS_TOKEN
# BACKUP_MYFILES_ENABLED=true
# BACKUP_MYFILES_RETAIN=3
